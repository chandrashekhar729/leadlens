{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/dashboard/serve.sh\"",
            "timeout": 10,
            "statusMessage": "LeadLens: dashboard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/scan-patterns.sh\" --hook",
            "timeout": 10,
            "statusMessage": "LeadLens: secret scan"
          }
        ]
      }
    ]
  }
}
